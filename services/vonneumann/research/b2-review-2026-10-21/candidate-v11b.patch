+-- FUNCTION _budget
+CREATE FUNCTION vn_jupiter_b2_allocation_research_v3._budget(scope_wire pg_catalog.text, kind pg_catalog.text, cost pg_catalog.jsonb)
+RETURNS pg_catalog.jsonb
+LANGUAGE plpgsql STABLE SECURITY INVOKER
+CALLED ON NULL INPUT PARALLEL UNSAFE COST 100
+SET search_path = 'pg_catalog', 'pg_temp'
+SET TimeZone = 'UTC'
+SET client_encoding = 'UTF8'
+SET standard_conforming_strings = 'on'
+AS $b2$
+DECLARE a jsonb; b jsonb; reserve bigint:=CASE WHEN kind='source_stop' THEN 0 ELSE 1 END; past_stage bigint:=0; v record;
+BEGIN
+ SELECT accounting_wire::jsonb INTO a FROM vn_jupiter_b2_allocation_research_v3.scope_state s WHERE s.scope_wire=_budget.scope_wire;
+ IF NOT FOUND THEN RAISE EXCEPTION 'b2_scope_refused'; END IF;
+ -- Derived counters are never hidden persisted fields in Accounting.
+ FOR v IN SELECT o.command_wire::jsonb c,o.result_wire::jsonb r FROM vn_jupiter_b2_allocation_research_v3.original_operations o WHERE o.scope_wire=_budget.scope_wire AND o.finalized LOOP
+  past_stage:=past_stage+(vn_jupiter_b2_allocation_research_v3._cost(v.c,v.r,'[]','[]')->>'stage_bytes')::bigint;
+ END LOOP;
+ IF (a->>'committed_positions')::bigint+1+reserve>16 OR (a->>'logical_UTF8_bytes')::bigint+(cost->>'bytes')::bigint+reserve*76533>4194304 OR (a->>'retained_rows')::bigint+(cost->>'new_rows')::bigint+reserve*9>271 OR (a->>'identity_rows')::bigint+(cost->>'identities')::bigint>96 OR (a->>'domain_rows')::bigint+(cost->>'domains')::bigint>25 OR (a->>'dependency_rows')::bigint+(cost->>'dependencies')::bigint+reserve*7>112 OR (a->>'row_writes')::bigint+(cost->>'row_writes')::bigint+reserve*10>512 OR (a->>'index_entries')::bigint+(cost->>'index_entries')::bigint+reserve*20>1024 THEN RAISE EXCEPTION 'b2_budget_refused'; END IF;
+ IF (a->>'row_writes')::bigint+(a->>'committed_positions')::bigint+(cost->>'row_writes')::bigint+1+reserve*11>1024 OR (a->>'index_entries')::bigint+3*(a->>'committed_positions')::bigint+(cost->>'index_entries')::bigint+3+reserve*23>2048 OR (a->>'logical_UTF8_bytes')::bigint+past_stage+(cost->>'bytes')::bigint+(cost->>'stage_bytes')::bigint+reserve*144142>8388608 THEN RAISE EXCEPTION 'b2_budget_refused'; END IF;
+ b:=pg_catalog.jsonb_build_object('committed_positions',((a->>'committed_positions')::bigint+1)::text,'logical_UTF8_bytes',((a->>'logical_UTF8_bytes')::bigint+(cost->>'bytes')::bigint)::text,'identity_rows',((a->>'identity_rows')::bigint+(cost->>'identities')::bigint)::text,'domain_rows',((a->>'domain_rows')::bigint+(cost->>'domains')::bigint)::text,'dependency_rows',((a->>'dependency_rows')::bigint+(cost->>'dependencies')::bigint)::text,'retained_rows',((a->>'retained_rows')::bigint+(cost->>'new_rows')::bigint)::text,'row_writes',((a->>'row_writes')::bigint+(cost->>'row_writes')::bigint)::text,'index_entries',((a->>'index_entries')::bigint+(cost->>'index_entries')::bigint)::text,'Stop_reserve_consumed',kind='source_stop');
+ RETURN b;
+END;
+$b2$;
