+"""Bounded Stop dispatch with a held worker transport and exact bytes."""
+from copy import deepcopy
+from dataclasses import replace
+import hashlib
+import json
+import unittest
+from uuid import UUID
+
+from vonneumann.research.native_stop_dispatch import StopDispatch, StopDispatchError, StopIntentPins
+
+
+def canonical(value):
+    return json.dumps(value, ensure_ascii=False, separators=(',', ':'), sort_keys=True).encode()
+
+
+def identity(value):
+    return str(UUID(int=value))
+
+
+class NativeStopDispatchTests(unittest.TestCase):
+    def setUp(self):
+        self.scope = dict(owner_id=identity(1), run_id=identity(2), market_epoch=identity(3))
+        self.pins = StopIntentPins(canonical(self.scope), identity(4), identity(5),
+                                   'a' * 64, 'b' * 64, 'c' * 64, identity(6))
+        self.command = dict(
+            format='ga-jupiter-b2-allocation-command-research-v3-v1',
+            native_policy_sha256='e5dca1d13839102fb1fdd261176393b73c770a95ab355eff74499169905bfba0',
+            scope=self.scope, action_id=identity(4), action_kind='source_stop',
+            expected_head=dict(native_sequence='4', native_head_sha256='e' * 64,
+                               previous_seal_sha256=None),
+            expected_fence_id=None, expected_fence_revision=None,
+            body=dict(expected_control_sha256='d' * 64, expected_mode='open'),
+        )
+        self.command_wire = canonical(self.command)
+        self.digest = hashlib.sha256(self.command_wire).hexdigest()
+        self.intent = dict(
+            format='ga-jupiter-b2-stop-intent-research-v3-v1', installation_id=identity(5),
+            native_package_sha256='a' * 64, effective_catalog_sha256='b' * 64,
+            handoff_sha256='c' * 64, control_binding_id=identity(6),
+            original_command_wire=self.command_wire.decode(), original_command_sha256=self.digest,
+        )
+        self.observation = dict(
+            format='ga-jupiter-b2-stop-intent-observation-research-v3-v1', scope=self.scope,
+            action_id=identity(4), resolution='observed_committed_exact',
+            intent_wire=canonical(self.intent).decode(),
+        )
+        self.committed_wire = canonical(self.observation)
+        self.calls = []
+
+    def guard(self):
+        return StopDispatch(self.command_wire, self.pins)
+
+    def read(self, query):
+        self.calls.append(('read', query))
+        return self.committed_wire
+
+    def submit(self, command):
+        self.calls.append(('submit', command))
+        return {'pending_commit': True}
+
+    def test_dispatches_exact_wire_only_after_one_positive_independent_read(self):
+        guard = self.guard()
+        self.assertIsNone(guard.dispatch(self.read, self.submit))
+        query = canonical(dict(
+            format='ga-jupiter-b2-original-query-research-v3-v1',
+            native_policy_sha256=self.command['native_policy_sha256'], scope=self.scope,
+            target_kind='source_stop', target_id=identity(4),
+            expected_original_command_sha256=self.digest,
+            correlation=dict(kind='original_action_id', id=identity(4)),
+        ))
+        self.assertEqual(self.calls, [('read', query), ('submit', self.command_wire)])
+        with self.assertRaisesRegex(StopDispatchError, 'already used'):
+            guard.dispatch(self.read, self.submit)
+        self.assertEqual(len(self.calls), 2)
+
+    def test_absence_provisional_or_changed_readback_never_dispatch(self):
+        absent = dict(self.observation, resolution='observed_absent_unknown', intent_wire=None)
+        other_scope = dict(self.scope, run_id=identity(8))
+        variants = {
+            'absent': canonical(absent),
+            'provisional': canonical(dict(self.observation, pending_commit=True)),
+            'wrong kind': canonical(dict(self.observation, format='other')),
+            'wrong scope': canonical(dict(self.observation, scope=other_scope)),
+            'wrong ID': canonical(dict(self.observation, action_id=identity(9))),
+            'malformed': b'{"incomplete"',
+            'duplicate': self.committed_wire[:-1] + b',"resolution":"observed_committed_exact"}',
+            'noncanonical': self.committed_wire + b'\n',
+            'wrong representation': self.committed_wire.decode(),
+        }
+        changed_command = deepcopy(self.command)
+        changed_command['expected_head']['native_sequence'] = '5'
+        for name, value in (
+            ('installation_id', identity(11)), ('native_package_sha256', 'f' * 64),
+            ('effective_catalog_sha256', 'f' * 64), ('handoff_sha256', 'f' * 64),
+            ('control_binding_id', identity(12)), ('original_command_sha256', 'f' * 64),
+            ('original_command_wire', canonical(changed_command).decode()),
+        ):
+            changed_intent = canonical(dict(self.intent, **{name: value})).decode()
+            variants[name] = canonical(dict(self.observation, intent_wire=changed_intent))
+        for name, result in variants.items():
+            with self.subTest(name=name):
+                guard = self.guard()
+                with self.assertRaisesRegex(StopDispatchError, 'could not be verified'):
+                    guard.dispatch(lambda query: result, self.submit)
+                with self.assertRaisesRegex(StopDispatchError, 'already used'):
+                    guard.dispatch(self.read, self.submit)
+        self.assertEqual(self.calls, [])
+
+    def test_refuses_malformed_originals_and_untrusted_identity_pins(self):
+        for key, value in (
+            ('action_kind', 'fence_renew'), ('action_id', identity(20)),
+            ('scope', dict(self.scope, run_id=identity(21))),
+            ('native_policy_sha256', '0' * 64), ('expected_fence_revision', '1'),
+            ('body', dict(self.command['body'], expected_mode='paused')),
+            ('expected_head', dict(self.command['expected_head'], native_sequence='16')),
+        ):
+            with self.subTest(key=key), self.assertRaisesRegex(StopDispatchError, 'pins are invalid'):
+                StopDispatch(canonical(dict(self.command, **{key: value})), self.pins)
+        for changed_wire, pins in (
+            (self.command_wire + b'\n', self.pins),
+            (self.command_wire, replace(self.pins, scope_wire=b'{}')),
+            (self.command_wire, replace(self.pins, handoff_sha256='bad')),
+            (self.command_wire, replace(self.pins, control_binding_id='bad')),
+        ):
+            with self.assertRaisesRegex(StopDispatchError, 'pins are invalid'):
+                StopDispatch(changed_wire, pins)
+        self.assertEqual(self.calls, [])
+
+    def test_reader_failure_closes_dispatch_without_echoing_details(self):
+        def failed_reader(query):
+            raise TimeoutError('private transport detail')
+
+        guard = self.guard()
+        with self.assertRaisesRegex(StopDispatchError, '^Committed original Stop intent could not be read$'):
+            guard.dispatch(failed_reader, self.submit)
+        with self.assertRaisesRegex(StopDispatchError, 'already used'):
+            guard.dispatch(self.read, self.submit)
+        self.assertEqual(self.calls, [])
+
+    def test_unknown_submit_requires_original_reconciliation_and_has_no_retry(self):
+        def lost_submit(command):
+            self.submit(command)
+            raise ConnectionError('private transport detail')
+
+        guard = self.guard()
+        with self.assertRaisesRegex(StopDispatchError, 'requires independent reconciliation'):
+            guard.dispatch(self.read, lost_submit)
+        with self.assertRaisesRegex(StopDispatchError, 'already used'):
+            guard.dispatch(self.read, self.submit)
+        self.assertEqual([kind for kind, _ in self.calls], ['read', 'submit'])
+
+    def test_reader_reentry_cannot_dispatch_a_second_attempt(self):
+        guard = self.guard()
+
+        def read_with_reentry(query):
+            with self.assertRaisesRegex(StopDispatchError, 'already used'):
+                guard.dispatch(self.read, self.submit)
+            return self.read(query)
+
+        guard.dispatch(read_with_reentry, self.submit)
+        self.assertEqual([kind for kind, _ in self.calls], ['read', 'submit'])
diff --git a/services/vonneumann/vonneumann/research/native_capture_dispatch.py b/services/vonneumann/vonneumann/research/native_capture_dispatch.py
new file mode 100644
index 0000000..8bfe19c
--- /dev/null
+++ b/services/vonneumann/vonneumann/research/native_capture_dispatch.py
@@ -0,0 +1,195 @@
+"""One local collection attempt after an exact native Reservation commits."""
+from __future__ import annotations
+
+from threading import Lock
+
+from ..market import provider_acquisition_v3 as codec
+from ..market import source_admission_v3 as source
+from ..market.provider_recorded_transport_v3 import PreparedPacket
+
+_KIND = 'packet_reservation'
+_B2_CONTROL_POLICY_SHA256 = 'e5dca1d13839102fb1fdd261176393b73c770a95ab355eff74499169905bfba0'
+_A1_IDS = (
+    'reservation_id', 'capture_id', 'admission_id', 'observation_id',
+    'price_record_id', 'genesis_record_id', 'block_time_record_id',
+)
+_NATIVE_IDS = ('read_observation_id', 'availability_id', 'closure_id', 'reconcile_id')
+_LIMITS = dict.fromkeys((
+    'provider_attested', 'calibrated_clock', 'hosted_authority',
+    'running_authority', 'live_trading_authority', 'model_native_join',
+), False)
+_HEAD_KEYS = {'native_sequence', 'native_head_sha256', 'previous_seal_sha256'}
+_COMMAND_KEYS = {
+    'format', 'native_policy_sha256', 'scope', 'action_id', 'action_kind',
+    'expected_head', 'expected_fence_id', 'expected_fence_revision', 'body',
+}
+_REPLY_KEYS = {
+    'format', 'native_policy_sha256', 'scope', 'target_id', 'target_kind',
+    'original_command_wire', 'original_result_wire', 'original_receipt_wire',
+    'dependencies', 'observed_head', 'limits',
+}
+
+
+class NativeCaptureDispatchError(ValueError):
+    """The original reservation cannot authorize provider collection."""
+
+    def __init__(self):
+        super().__init__('Native collection refused or unresolved')
+
+
+def _format(record):
+    return f'ga-jupiter-b2-{record}-research-v3-v1'
+
+
+def _utc(value):
+    codec.fields(value, {'observed_at_us', 'wall_lower_us', 'wall_upper_us'})
+    lower, observed, upper = (codec.counter(value[key], minimum=1)
+        for key in ('wall_lower_us', 'observed_at_us', 'wall_upper_us'))
+    codec.require(lower <= observed <= upper)
+    return observed
+
+
+class ReservationCollection:
+    """The submit callback returns only after COMMIT acknowledgment.
+
+    The reader callback uses a separate authenticated reader connection and
+    executes the supplied original query once. Callback identity and database
+    target verification belong to the enclosing worker adapter.
+    """
+
+    def __init__(self, command_wire: bytes, prepared: PreparedPacket, *,
+                 expected_policy_sha256: str, expected_native_package_sha256: str,
+                 expected_catalog_manifest_sha256: str):
+        try:
+            self._package = codec.digest(expected_native_package_sha256)
+            self._catalog = codec.digest(expected_catalog_manifest_sha256)
+            policy = codec.digest(expected_policy_sha256)
+            command = codec.read_json(command_wire, 16384, exact=True)
+            codec.fields(command, _COMMAND_KEYS)
+            codec.require(command['format'] == _format('allocation-command')
+                          and command['action_kind'] == _KIND
+                          and command['native_policy_sha256'] == policy)
+            source.scope(command['scope'])
+            codec.uuid(command['action_id'])
+            self._fence_id = codec.uuid(command['expected_fence_id'])
+            self._fence_revision = command['expected_fence_revision']
+            codec.counter(self._fence_revision, maximum=16, minimum=1)
+            head = command['expected_head']
+            codec.fields(head, _HEAD_KEYS)
+            codec.digest(head['native_head_sha256'])
+            codec.require(head['previous_seal_sha256'] is None)
+            self._sequence = str(codec.counter(head['native_sequence'], maximum=14, minimum=1) + 1)
+            self._previous_head = head['native_head_sha256']
+
+            body = command['body']
+            codec.fields(body, {'reservation_wire', 'prepared_packet_wire', *_NATIVE_IDS})
+            self._reservation = source.wire(body['reservation_wire'], 'Reservation')
+            reservation = self._reservation.to_dict()
+            codec.require(reservation['scope'] == command['scope']
+                          and reservation['reservation_id'] == command['action_id'])
+            codec.require(type(prepared) is PreparedPacket and prepared.binding == source.issuer(reservation['issuer']))
+            for key in ('observation_id', 'price_record_id', 'genesis_record_id', 'block_time_record_id'):
+                codec.require(getattr(prepared, key) == reservation[key])
+            for key in ('genesis_rpc_id', 'block_time_rpc_id'):
+                codec.require(str(getattr(prepared, key)) == reservation[key])
+            prepared_wire = prepared.wire
+            codec.require(body['prepared_packet_wire'] == prepared_wire.decode('utf-8'))
+            packet_ids = {key: reservation[key] for key in _A1_IDS}
+            packet_ids.update((key, codec.uuid(body[key])) for key in _NATIVE_IDS)
+            codec.require(len(set(packet_ids.values())) == len(packet_ids))
+            self._fence_holder = reservation['issuer_principal_binding_id']
+            self._result_body = dict(packet_ids=packet_ids,
+                original_a1_reservation_sha256=self._reservation.sha256,
+                prepared_packet_sha256=source.sha(prepared_wire), capture_status='unresolved')
+        except (ValueError, TypeError, KeyError, AttributeError, OverflowError, RecursionError):
+            raise NativeCaptureDispatchError() from None
+
+        self._prepared = prepared
+        self._command_wire = command_wire
+        self._command_text = command_wire.decode('utf-8')
+        self._common = dict(native_policy_sha256=policy, scope=command['scope'], limits=_LIMITS)
+        self._target = dict(target_id=command['action_id'], target_kind=_KIND)
+        self._action = dict(action_id=command['action_id'], action_kind=_KIND,
+                            original_command_sha256=source.sha(command_wire))
+        self._query = codec.canonical(dict(format=_format('original-query'),
+            native_policy_sha256=policy, scope=command['scope'], **self._target,
+            expected_original_command_sha256=self._action['original_command_sha256'],
+            correlation={'kind': 'original_action_id', 'id': command['action_id']}))
+        self._attempt_lock = Lock()
+        self._attempted = False
+
+    def collect(self, submit_recorder, independent_reader, collector):
+        with self._attempt_lock:
+            if self._attempted:
+                raise NativeCaptureDispatchError()
+            self._attempted = True
+        try:
+            submitted = submit_recorder(self._command_wire)
+            expected = dict(format=_format('provisional'), **self._common,
+                            **self._action, pending_commit=True)
+            codec.require(type(submitted) is bytes and submitted == codec.canonical(expected))
+            self._verify_committed(independent_reader(self._query))
+            capture = collector(self._prepared)
+            return source.validate_capture(self._reservation, capture)
+        except Exception:
+            # The original remains unresolved after a failed or lost reply.
+            raise NativeCaptureDispatchError() from None
+
+    def _verify_committed(self, wire):
+        reply = codec.read_json(wire, 8 * 1024 * 1024, exact=True)
+        codec.fields(reply, _REPLY_KEYS)
+        expected = dict(format=_format('original-reply'), **self._common,
+                        **self._target, original_command_wire=self._command_text)
+        codec.require(all(reply[key] == value for key, value in expected.items()))
+        codec.require(type(reply['dependencies']) is list and 0 < len(reply['dependencies']) <= 70)
+
+        result_wire = reply['original_result_wire'].encode('utf-8')
+        result = codec.read_json(result_wire, 16384, exact=True)
+        expected_result = dict(format=_format('allocation-result'), **self._common,
+            **self._action, native_sequence=self._sequence, result_body=self._result_body)
+        codec.fields(result, {*expected_result, 'dependencies'})
+        codec.require(all(result[key] == value for key, value in expected_result.items()))
+        fence = self._verify_reservation_pins(result['dependencies'], reply['dependencies'])
+        result_sha = source.sha(result_wire)
+
+        receipt_wire = reply['original_receipt_wire'].encode('utf-8')
+        receipt = codec.read_json(receipt_wire, 4096, exact=True)
+        expected_receipt = dict(format=_format('allocation-receipt'), **self._common,
+            **self._action, native_sequence=self._sequence, result_sha256=result_sha,
+            previous_native_head_sha256=self._previous_head, admission_observation=None,
+            native_package_sha256=self._package, catalog_manifest_sha256=self._catalog)
+        codec.fields(receipt, {*expected_receipt, 'final_function_observation', 'commit_processing_observation'})
+        codec.require(all(receipt[key] == value for key, value in expected_receipt.items()))
+        final = _utc(receipt['final_function_observation'])
+        committed = _utc(receipt['commit_processing_observation'])
+        codec.require(codec.counter(fence['issued_at_us']) <= final <= committed < codec.counter(fence['expires_at_us']))
+
+        journal = dict(native_sequence=self._sequence, **self._action,
+            original_result_sha256=result_sha, original_receipt_sha256=source.sha(receipt_wire),
+            previous_native_head_sha256=self._previous_head)
+        codec.require(reply['observed_head'] == dict(native_sequence=self._sequence,
+            native_head_sha256=source.sha(codec.canonical(journal)), previous_seal_sha256=None))
+
+    def _verify_reservation_pins(self, direct, complete):
+        codec.require(type(direct) is list and len(direct) == 2)
+        verified = {}
+        for pin in direct:
+            codec.fields(pin, {'semantic_kind', 'original_id', 'original_wire', 'wire_sha256', 'wire_bytes'})
+            kind = pin['semantic_kind']
+            codec.require(kind in ('native_command', 'native_fence_record') and kind not in verified)
+            codec.require(pin in complete)
+            codec.uuid(pin['original_id'])
+            body = pin['original_wire'].encode('utf-8')
+            codec.require(pin['wire_bytes'] == str(len(body)) and pin['wire_sha256'] == source.sha(body))
+            value = codec.read_json(body, 16384, exact=True)
+            codec.require(value['scope'] == self._common['scope'])
+            if kind == 'native_command':
+                codec.require(value['action_id'] == pin['original_id'] and value['action_kind'] == 'fence_renew'
+                              and value['native_policy_sha256'] == _B2_CONTROL_POLICY_SHA256)
+            else:
+                codec.require(value['fence_id'] == pin['original_id'] == self._fence_id
+                              and value['revision'] == self._fence_revision
+                              and value['holder_principal_binding_id'] == self._fence_holder
+                              and value['acquisition_epoch'] == self._prepared.binding.acquisition_epoch)
+            verified[kind] = value
+        return verified['native_fence_record']
diff --git a/services/vonneumann/vonneumann/research/native_stop_dispatch.py b/services/vonneumann/vonneumann/research/native_stop_dispatch.py
new file mode 100644
index 0000000..50dd199
--- /dev/null
+++ b/services/vonneumann/vonneumann/research/native_stop_dispatch.py
@@ -0,0 +1,128 @@
+"""One held B2 Stop dispatch gated by an independently authenticated reader."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+from threading import Lock
+from typing import Callable
+
+from ..market import provider_acquisition_v3 as wire
+
+
+NATIVE_POLICY_SHA256 = 'e5dca1d13839102fb1fdd261176393b73c770a95ab355eff74499169905bfba0'
+
+
+class StopDispatchError(RuntimeError):
+    """Fixed error text keeps credential and database response details private."""
+
+
+@dataclass(frozen=True, slots=True)
+class StopIntentPins:
+    """Trusted pins from the selected scope, installation and K2 handoff."""
+
+    scope_wire: bytes
+    reserved_stop_id: str
+    installation_id: str
+    native_package_sha256: str
+    effective_catalog_sha256: str
+    handoff_sha256: str
+    control_binding_id: str
+
+
+class StopDispatch:
+    """Hold one exact Stop. Dispatch once only after committed intent readback.
+
+    The caller supplies an independent scoped reader and a separate control
+    submit transport. The native getter authenticates the reader. This guard
+    validates the returned bytes against already trusted scope and handoff
+    pins. The original-operation getter remains responsible for the Stop
+    outcome. A lost submit response requires reconciliation of the same
+    original. Creating another guard cannot establish permission to retry it.
+    """
+
+    def __init__(self, command_wire: bytes, pins: StopIntentPins):
+        try:
+            if type(pins) is not StopIntentPins:
+                raise wire.AcquisitionError()
+            scope = wire.fields(wire.read_json(pins.scope_wire, 512, exact=True),
+                                {'owner_id', 'run_id', 'market_epoch'})
+            for identity in scope.values():
+                wire.uuid(identity)
+            stop_id = wire.uuid(pins.reserved_stop_id)
+            command = wire.fields(wire.read_json(command_wire, 4096, exact=True), {
+                'format', 'native_policy_sha256', 'scope', 'action_id', 'action_kind',
+                'expected_head', 'expected_fence_id', 'expected_fence_revision', 'body',
+            })
+            wire.require(
+                command['format'] == 'ga-jupiter-b2-allocation-command-research-v3-v1'
+                and command['native_policy_sha256'] == NATIVE_POLICY_SHA256
+                and command['scope'] == scope and command['action_id'] == stop_id
+                and command['action_kind'] == 'source_stop'
+                and command['expected_fence_id'] is None
+                and command['expected_fence_revision'] is None
+            )
+            head = wire.fields(command['expected_head'], {
+                'native_sequence', 'native_head_sha256', 'previous_seal_sha256',
+            })
+            wire.counter(head['native_sequence'], minimum=3, maximum=15)
+            wire.digest(head['native_head_sha256'])
+            wire.require(head['previous_seal_sha256'] is None)
+            body = wire.fields(command['body'], {'expected_control_sha256', 'expected_mode'})
+            wire.digest(body['expected_control_sha256'])
+            wire.require(body['expected_mode'] == 'open')
+
+            command_sha256 = hashlib.sha256(command_wire).hexdigest()
+            intent = wire.canonical({
+                'format': 'ga-jupiter-b2-stop-intent-research-v3-v1',
+                'installation_id': wire.uuid(pins.installation_id),
+                'native_package_sha256': wire.digest(pins.native_package_sha256),
+                'effective_catalog_sha256': wire.digest(pins.effective_catalog_sha256),
+                'handoff_sha256': wire.digest(pins.handoff_sha256),
+                'control_binding_id': wire.uuid(pins.control_binding_id),
+                'original_command_wire': command_wire.decode('utf-8'),
+                'original_command_sha256': command_sha256,
+            })
+            wire.require(len(intent) <= 4096)
+            query = wire.canonical({
+                'format': 'ga-jupiter-b2-original-query-research-v3-v1',
+                'native_policy_sha256': NATIVE_POLICY_SHA256,
+                'scope': scope,
+                'target_kind': 'source_stop',
+                'target_id': stop_id,
+                'expected_original_command_sha256': command_sha256,
+                'correlation': {'kind': 'original_action_id', 'id': stop_id},
+            })
+            observation = wire.canonical({
+                'format': 'ga-jupiter-b2-stop-intent-observation-research-v3-v1',
+                'scope': scope,
+                'action_id': stop_id,
+                'resolution': 'observed_committed_exact',
+                'intent_wire': intent.decode('utf-8'),
+            })
+        except wire.AcquisitionError:
+            raise StopDispatchError('Original Stop or its trusted pins are invalid') from None
+        self._command_wire = command_wire
+        self._query_wire = query
+        self._committed_observation = observation
+        self._attempt_lock = Lock()
+        self._attempted = False
+
+    def dispatch(self, read_intent: Callable[[bytes], bytes],
+                 submit_stop: Callable[[bytes], None]) -> None:
+        with self._attempt_lock:
+            if self._attempted:
+                raise StopDispatchError('Original Stop dispatch attempt was already used')
+            self._attempted = True
+        try:
+            observed = read_intent(self._query_wire)
+        except Exception:
+            raise StopDispatchError('Committed original Stop intent could not be read') from None
+        # The entire positive observation is deterministic. Byte equality also
+        # refuses noncanonical encodings, provisional or absent replies and
+        # mismatches in any nested command or trusted intent pin.
+        if type(observed) is not bytes or observed != self._committed_observation:
+            raise StopDispatchError('Committed original Stop intent could not be verified')
+        try:
+            submit_stop(self._command_wire)
+        except Exception:
+            raise StopDispatchError('Original Stop submit outcome requires independent reconciliation') from None
