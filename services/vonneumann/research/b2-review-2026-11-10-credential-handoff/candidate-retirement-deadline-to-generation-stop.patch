+-- FUNCTION get_stop_intent
+CREATE FUNCTION vn_jupiter_b2_allocation_research_v3.get_stop_intent(wire pg_catalog.text)
+RETURNS pg_catalog.text
+LANGUAGE plpgsql STABLE SECURITY DEFINER
