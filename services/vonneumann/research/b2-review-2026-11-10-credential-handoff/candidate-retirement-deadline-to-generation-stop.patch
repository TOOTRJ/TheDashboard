+ IF wire IS NULL OR pg_catalog.octet_length(wire)>2048 THEN RAISE EXCEPTION 'b2_stop_intent_query_refused'; END IF;
+ query:=wire::jsonb;
+ IF NOT vn_jupiter_b2_allocation_research_v3._keys(query,ARRAY[
